@model StudyRoomBooking.Models.Equipment

@{
    ViewData["Title"] = "Opprett utstyr";
}

<h1>Legg til utstyr</h1>

<form asp-action="Create" method="post">

    <div class="mb-3">
        <label asp-for="Name">Navn</label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Description">Beskrivelse</label>
        <textarea asp-for="Description" class="form-control"></textarea>
    </div>

    <div class="mb-3">
        <label asp-for="Quantity">Antall</label>
        <input asp-for="Quantity" type="number" min="0" class="form-control" />
    </div>

    <button type="submit" class="btn btn-primary">Lagre utstyr</button>

    <a asp-action="Index" class="btn btn-secondary">Tilbake</a>

</form>