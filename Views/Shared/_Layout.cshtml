
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - StudyRoomBooking</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/StudyRoomBooking.styles.css"
          asp-append-version="true" />
</head>

<body class="bg-light">

    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom shadow-sm mb-4">
            <div class="container">

                <a class="navbar-brand fw-bold"
                   asp-controller="Home"
                   asp-action="Index">
                    StudyRoomBooking
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar"
                        aria-expanded="false"
                        aria-label="Toggle navigation">

                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse"
                     id="mainNavbar">

                    <ul class="navbar-nav me-auto">

                        <li class="nav-item">
                            <a class="nav-link @(currentController == "Home" ? "active fw-semibold" : "")"
                               asp-controller="Home"
                               asp-action="Index"
                               aria-current="@(currentController == "Home" ? "page" : null)">
                                Home
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link @(currentController == "Room" ? "active fw-semibold" : "")"
                               asp-controller="Room"
                               asp-action="Index"
                               aria-current="@(currentController == "Room" ? "page" : null)">
                                Rooms
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link @(currentController == "Booking" ? "active fw-semibold" : "")"
                               asp-controller="Booking"
                               asp-action="Index"
                               aria-current="@(currentController == "Booking" ? "page" : null)">
                                Bookings
                            </a>
                        </li>

                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link @(currentController == "Equipment" ? "active fw-semibold" : "")"
                                   asp-controller="Equipment"
                                   asp-action="Index"
                                   aria-current="@(currentController == "Equipment" ? "page" : null)">
                                    Equipment
                                </a>
                            </li>
                        }

                    </ul>

                    <partial name="_LoginPartial" />

                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-4">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top bg-white text-muted py-3 mt-4">
        <div class="container text-center">
            &copy; 2026 - StudyRoomBooking by ctrlfreaks
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>

