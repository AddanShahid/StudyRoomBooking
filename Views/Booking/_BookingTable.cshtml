
@model IEnumerable<StudyRoomBooking.Models.Booking>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th>Student</th>
                <th>Room</th>
                <th>Subject</th>
                <th>Topic</th>
                <th>Date</th>
                <th>Start</th>
                <th>End</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.StudentName</td>
                    <td>@item.Room?.Name</td>
                    <td>@item.Subject</td>
                    <td>@item.Topic</td>
                    <td>@item.Date.ToString("dd.MM.yyyy")</td>
                    <td>@item.StartTime.ToString("HH:mm")</td>
                    <td>@item.EndTime.ToString("HH:mm")</td>
                    <td>
                        <a asp-controller="Booking"
                           asp-action="Edit"
                           asp-route-id="@item.Id"
                           class="booking-edit-button">
                            Edit
                        </a>

                        <a asp-controller="Booking"
                           asp-action="Details"
                           asp-route-id="@item.Id"
                           class="booking-details-button">
                            Details
                        </a>

                        <a asp-controller="Booking"
                           asp-action="Delete"
                           asp-route-id="@item.Id"
                           class="booking-delete-button">
                            Delete
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
