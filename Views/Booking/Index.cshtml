
@model IEnumerable<StudyRoomBooking.Models.Booking>

@{
    ViewData["Title"] = "Bookings";

    var rooms = ViewBag.Rooms as List<StudyRoomBooking.Models.Room>
        ?? new List<StudyRoomBooking.Models.Room>();

    var equipments = ViewBag.Equipments as List<StudyRoomBooking.Models.Equipment>
        ?? new List<StudyRoomBooking.Models.Equipment>();

    string? selectedSubject = ViewBag.SelectedSubject;
    DateTime? selectedDate = ViewBag.SelectedDate;
    int? selectedRoomId = ViewBag.SelectedRoomId;
    int? selectedEquipmentId = ViewBag.SelectedEquipmentId;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1>Bookings</h1>
        <p class="text-muted mb-0">
            View and manage your study room bookings.
        </p>
    </div>

    <a asp-action="Create" class="booking-create-button">
        + Create Booking
    </a>
</div>

<div class="card mb-4">
    <div class="card-body">
        <h5 class="card-title mb-3">Search and filter bookings</h5>

        <form asp-controller="Booking" asp-action="Index" method="get">

            <div class="row g-3">

                <div class="col-md-6">
                    <label for="subject" class="form-label">Subject</label>
                    <input type="text"
                           id="subject"
                           name="subject"
                           class="form-control"
                           placeholder="Search by subject"
                           value="@selectedSubject" />
                </div>

                <div class="col-md-6">
                    <label for="date" class="form-label">Date</label>
                    <input type="date"
                           id="date"
                           name="date"
                           class="form-control"
                           value="@(selectedDate?.ToString("yyyy-MM-dd"))" />
                </div>

                <div class="col-md-6">
                    <label for="roomId" class="form-label">Room</label>
                    <select id="roomId" name="roomId" class="form-select">
                        <option value="">All rooms</option>

                        @foreach (var room in rooms)
                        {
                            if (selectedRoomId == room.Id)
                            {
                                <option value="@room.Id" selected>@room.Name</option>
                            }
                            else
                            {
                                <option value="@room.Id">@room.Name</option>
                            }
                        }
                    </select>
                </div>

                <div class="col-md-6">
                    <label for="equipmentId" class="form-label">Equipment</label>
                    <select id="equipmentId" name="equipmentId" class="form-select">
                        <option value="">All equipment</option>

                        @foreach (var equipment in equipments)
                        {
                            if (selectedEquipmentId == equipment.Id)
                            {
                                <option value="@equipment.Id" selected>@equipment.Name</option>
                            }
                            else
                            {
                                <option value="@equipment.Id">@equipment.Name</option>
                            }
                        }
                    </select>
                </div>

            </div>

            <div class="mt-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary">
                    Search
                </button>

                <a asp-controller="Booking"
                   asp-action="Index"
                   class="btn btn-secondary">
                    Reset
                </a>
            </div>

        </form>
    </div>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">
        No bookings found matching your filters.
    </div>
}
else
{
    <p class="text-muted">
        Showing @Model.Count() booking(s).
    </p>

    <partial name="_BookingTable" model="Model" />
}
