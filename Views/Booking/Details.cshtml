
@model StudyRoomBooking.Models.Booking

@{
    ViewData["Title"] = "Booking Details";

    var currentUser = User.Identity?.Name;

    var myParticipation = Model.Participations?
        .FirstOrDefault(p =>
            !string.IsNullOrWhiteSpace(currentUser) &&
            string.Equals(
                p.StudentName,
                currentUser,
                StringComparison.OrdinalIgnoreCase));
}

<h1>Booking Details</h1>

<div class="card mb-4">
    <div class="card-body">
        <h4>Booking Information</h4>
        <hr />

        <dl class="row">
            <dt class="col-sm-3">Student</dt>
            <dd class="col-sm-9">@Model.StudentName</dd>

            <dt class="col-sm-3">Room</dt>
            <dd class="col-sm-9">@Model.Room?.Name</dd>

            <dt class="col-sm-3">Subject</dt>
            <dd class="col-sm-9">@Model.Subject</dd>

            <dt class="col-sm-3">Topic</dt>
            <dd class="col-sm-9">@Model.Topic</dd>

            <dt class="col-sm-3">Date</dt>
            <dd class="col-sm-9">@Model.Date.ToString("dd.MM.yyyy")</dd>

            <dt class="col-sm-3">Start Time</dt>
            <dd class="col-sm-9">@Model.StartTime.ToString("HH:mm")</dd>

            <dt class="col-sm-3">End Time</dt>
            <dd class="col-sm-9">@Model.EndTime.ToString("HH:mm")</dd>
        </dl>
    </div>
</div>

@if (Model.Room?.Equipment != null && Model.Room.Equipment.Any())
{
    <div class="card mb-4">
        <div class="card-body">
            <h4>Equipment in this room</h4>

            <ul>
                @foreach (var equipment in Model.Room.Equipment)
                {
                    <li>@equipment.Name</li>
                }
            </ul>
        </div>
    </div>
}

<div class="card mb-4">
    <div class="card-body">
        <h4>Participants</h4>

        @if (Model.Participations != null && Model.Participations.Any())
        {
            <ul class="list-group">
                @foreach (var participation in Model.Participations)
                {
                    <li class="list-group-item">
                        <strong>@participation.StudentName</strong>

                        @if (!string.IsNullOrWhiteSpace(participation.Message))
                        {
                            <span> - @participation.Message</span>
                        }

                        @if (myParticipation?.Id == participation.Id)
                        {
                            <form asp-controller="Participation"
                                  asp-action="Delete"
                                  asp-route-id="@participation.Id"
                                  method="post"
                                  class="mt-2">

                                @Html.AntiForgeryToken()

                                <button type="submit"
                                        class="btn btn-outline-danger btn-sm">
                                    Leave Booking
                                </button>
                            </form>
                        }
                    </li>
                }
            </ul>
        }
        else
        {
            <p>No participants have joined this booking yet.</p>
        }
    </div>
</div>

@if (User.Identity?.IsAuthenticated == true)
{
    if (myParticipation == null)
    {
        <div class="card mb-4">
            <div class="card-body">
                <h4>Join this Booking</h4>

                <p class="text-muted">
                    You will join as @currentUser
                </p>

                <form asp-controller="Participation"
                      asp-action="Create"
                      method="post">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           name="bookingId"
                           value="@Model.Id" />

                    <div class="mb-3">
                        <label for="message" class="form-label">
                            Message (optional)
                        </label>

                        <textarea id="message"
                                  name="message"
                                  class="form-control"
                                  maxlength="500"></textarea>
                    </div>

                    <button type="submit" class="btn btn-success">
                        Join Booking
                    </button>
                </form>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-success">
            You have joined this booking.
        </div>
    }
}
else
{
    <div class="alert alert-info">
        Please log in to join this booking.
    </div>
}

<div class="mt-3">
    <a asp-action="Edit"
       asp-route-id="@Model.Id"
       class="btn btn-warning">
        Edit
    </a>

    <a asp-action="Index"
       class="btn btn-secondary">
        Back to List
    </a>
</div>
