
@model StudyRoomBooking.Models.Room

@{
    ViewData["Title"] = "Slett rom";
}

<h1>Slett rom</h1>

<h4>Er du sikker på at du vil slette dette rommet?</h4>

<hr />

<div>
    <dl class="row">
        <dt class="col-sm-3">Romnavn</dt>
        <dd class="col-sm-9">@Model.Name</dd>

        <dt class="col-sm-3">Lokasjon</dt>
        <dd class="col-sm-9">@Model.Location</dd>

        <dt class="col-sm-3">Kapasitet</dt>
        <dd class="col-sm-9">@Model.Capacity</dd>
    </dl>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Id" />

        <button type="submit" class="btn btn-danger">
            Ja, slett rommet
        </button>

        <a asp-action="Index" class="btn btn-secondary">
            Avbryt
        </a>
    </form>
</div>
